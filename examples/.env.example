# 复制成 .env 后填写你自己的值
# 这个文件本身不含任何真实凭证

# 企业微信群机器人 Webhook 地址
# 形如：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=你自己的key
WECOM_WEBHOOK=你自己的群机器人Webhook地址

# GitHub 仓库监控（案例一）
# 形如：https://github.com/owner/repo
GH_REPO=owner/repo

# 被监控的站点（案例二）
TARGET_URL=https://你自己的站点.example.com

# 检查间隔（秒）
CHECK_INTERVAL=600

# 门铃服务的公开地址（案例三）
KEEPER_URL=https://你自己的服务.example.com

# 云平台 API（案例三，按你用的平台填）
CLOUD_API_BASE=https://你自己的云平台API地址
CLOUD_API_KEY=你自己的云平台API密钥
CLOUD_MACHINE_ID=你自己的机器ID

# 门铃收到的 webhook 验签密钥
WEBHOOK_SECRET=你自己的webhook签名密钥
